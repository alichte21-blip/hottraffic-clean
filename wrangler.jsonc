{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hottraffic-clean",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hottraffic-live",
      "database_id": "f116dcd7-0067-4f7b-9f25-438635bee0d9"
    }
  ]
}
